APP_NAME=QuantumBlack M&A Deal OS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database. SQLite for local dev; use a free hosted Postgres (Neon/Supabase) for
# a cloud-ready setup. Paste the connection string from Neon/Supabase here — a
# plain postgres:// or postgresql:// URL is auto-routed to the psycopg v3 driver.
#   Example (Neon): DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./ma_deal_os.db

# Security / RBAC
DEFAULT_ROLE=analyst

# Authentication (JWT). AUTH_ENFORCED=false keeps the legacy x-user-role header
# working for local dev; set true to require a Bearer token from /api/v1/auth/login.
AUTH_ENFORCED=false
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRE_MINUTES=480
# Shared password for the demo users (analyst/associate/vp/director/md/admin).
DEMO_PASSWORD=changeme-demo

# AI provider routing: local (free deterministic) | groq (free LLM) | anthropic (paid)
AI_PROVIDER=local
USE_ANTHROPIC=false

# Groq free LLM (https://console.groq.com — free key, fast). Set AI_PROVIDER=groq to use.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (optional premium mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FinBERT financial-sentiment model (free, Hugging Face; ~440MB on first use).
FINBERT_MODEL=ProsusAI/finbert

# Finnhub free market data (https://finnhub.io — free key, 60 calls/minute).
# Leave blank to disable; market endpoints then report "not configured".
FINNHUB_API_KEY=
# Patent-velocity signal. Default source is Google Patents (keyless) but it throttles
# heavy use. For a throttle-proof official source, get a free self-serve key from the
# USPTO Open Data Portal (https://data.uspto.gov → "My API Key") and set it here:
USPTO_API_KEY=
# Optional legacy fallback (emailed key, host flaky):
PATENTSVIEW_API_KEY=
# GDELT (news) and SEC EDGAR (M&A deal history) need NO key — always available.

# Optional location services. The frontend uses VITE_GOOGLE_MAPS_API_KEY when configured.
GOOGLE_MAPS_API_KEY=

# Strategy knobs
SYNERGY_NPV_MULTIPLE=5.0

# Outputs
PITCHBOOK_OUTPUT_DIR=generated_pitchbooks
